generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Chains {
    id                  Int     @id @default(autoincrement())
    name                String
    rpcUrl              String
    gasLimit            Int
    isCandideEnabled    Boolean @default(false)
    bundlerUrl          String?
    paymasterUrl        String?
    sponsorshipPolicyId String?

    daos DAOs[]
}

model DAOs {
    id          String  @id @default(cuid())
    daoId       String?
    alternateId String
    chainId     Int
    chain       Chains  @relation(fields: [chainId], references: [id])
    platform    String
    latestIndex String?
    votingDelay Int?

    deployments Deployments[]
    proposals   Proposals[]
}

model Deployments {
    id      String @id @default(cuid())
    address String
    name    String
    abi     Json
    daoId   String
    dao     DAOs   @relation(fields: [daoId], references: [id])
}

model Proposals {
    id        String   @id @default(cuid())
    daoId     String
    dao       DAOs     @relation(fields: [daoId], references: [id])
    title     String
    summary   String
    choices   String[]
    startDate DateTime
    endDate   DateTime

    decisions Decision[]
}

enum Status {
    PENDING
    DECIDED
    FAILED
}

model Decision {
    id         String    @id @default(cuid())
    proposalId String
    proposal   Proposals @relation(fields: [proposalId], references: [id])
    vote       Int?
    reason     String?
    status     Status

    executions Execution[]
}

enum ExecutionStatus {
    SUCCESS
    PENDING
    FAILED
}

model Execution {
    id         String          @id @default(cuid())
    decisionId String
    decision   Decision        @relation(fields: [decisionId], references: [id])
    status     ExecutionStatus
    metadata   Json
}
